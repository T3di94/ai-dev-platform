# Set to real to enable external provider calls. CI/E2E should leave this unset.
AGENT_PROVIDER_MODE=real
AGENT_REQUEST_TIMEOUT_MS=120000

# Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# OpenAI Codex
OPENAI_API_KEY=
OPENAI_CODEX_MODEL=gpt-5.3-codex

# Devin-compatible API endpoint. Keep the endpoint configurable because
# Devin deployments/API contracts can differ by account/product.
DEVIN_API_KEY=
DEVIN_API_URL=
