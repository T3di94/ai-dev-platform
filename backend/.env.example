# Runtime: mock (CI-safe), local (Ollama), or api (cloud providers).
AGENT_PROVIDER_MODE=local
AGENT_REQUEST_TIMEOUT_MS=120000

# Local Ollama runtime (no cloud API key required).
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_MODEL_CLAUDE=qwen2.5-coder:7b
OLLAMA_MODEL_DEVIN=qwen2.5-coder:7b
OLLAMA_MODEL_CODEX=qwen2.5-coder:7b

# Cloud/API runtime. Only needed when AGENT_PROVIDER_MODE=api.
# Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# OpenAI Codex
OPENAI_API_KEY=
OPENAI_CODEX_MODEL=gpt-5.3-codex

# Devin-compatible API endpoint. Keep the endpoint configurable because
# Devin deployments/API contracts can differ by account/product.
DEVIN_API_KEY=
DEVIN_API_URL=
