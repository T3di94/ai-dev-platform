# Runtime: mock (CI-safe), local (Ollama), or api (cloud providers).
AGENT_PROVIDER_MODE=local
AGENT_REQUEST_TIMEOUT_MS=120000
AGENT_MAX_ATTEMPTS=2
AGENT_TIMEOUT_MS=45000

# Backend security. If ADMIN_TOKEN is set, all mutating endpoints require Bearer auth.
ADMIN_TOKEN=replace-with-a-long-random-token
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# Persistent storage
AI_DEV_DATA_FILE=.data/store.json

# Local Ollama runtime (no cloud API key required).
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_MODEL_CLAUDE=qwen2.5-coder:7b
OLLAMA_MODEL_DEVIN=qwen2.5-coder:7b
OLLAMA_MODEL_CODEX=qwen2.5-coder:7b

# Cloud/API runtime. Only needed when AGENT_PROVIDER_MODE=api.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
OPENAI_API_KEY=
OPENAI_CODEX_MODEL=gpt-5.3-codex
DEVIN_API_KEY=
DEVIN_API_URL=
